# Public values only. The application does not load .env files automatically.
# Production DJANGO_SECRET_KEY is generated in Azure by Bicep; never put it here.
# Owner password is read through getpass by scripts/owner.py; only its hash is stored.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
AZURE_CREDENTIAL_MODE=cli
AZURE_STORAGE_ACCOUNT=
AZURE_TENANT_ID=
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=django-luna
AZURE_DECISION_DEPLOYMENT=django-decision
BING_CONNECTION_ID=
BING_CUSTOM_SEARCH_INSTANCE_NAME=django-official
MODEL_CALL_LIMIT=12
BING_QUERY_LIMIT=6
LAB_EXPIRES_AT=2026-11-09T09:00:00Z
# azd parameters; choose dates from your own approved plan before provisioning.
CLEANUP_AT=2026-11-09T10:00:00+01:00
